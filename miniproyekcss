*
 {scroll-behavior: smooth; /* Kunci rahasia efek meluncur halus tanpa JavaScript */
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: sans-serif;
    background-image: url('menu_pink_background.jpg');
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
    background-attachment: fixed;
    min-height: 1080px;
    margin: 0;
}

nav {
    width: 100%;
    padding: 16px 5%;
    background-image: url('pinkfooter_navbarbackground.jpeg');
    background-attachment: fixed;
    margin-bottom: 32px;

    display: flex;
    align-items: center;
    justify-content: space-between;
}

.source {
    height: 50px;
    width: auto;
    display: block;
}

.source:hover {
    box-shadow: 5px 5px 15px 0px rgba(0, 0, 0, 0.3);
}

.logo-a {
    font-size: 23px;
    font-weight: 700;
    color: rgba(74, 45, 107, 1.0);
    letter-spacing: 1px;
    transition: 0.3s;
}

.logo-a:hover {
    font-size: 26px;
    font-weight: 700;
    color: rgba(247, 126, 203, 1.0);
    letter-spacing: 1px;
    text-shadow: 0 0 10px rgba(32, 26, 41, 1.0);
}

.nav-links {
    list-style: none;
    display: flex;
    gap: 16px;
}

.nav-links li a {
    position: relative;
    font-size: 23px;
    font-weight: 540;
    text-decoration: none;
    color: rgba(74, 45, 107, 1.0);
    transition: 0.3s;
}

.nav-links li a:hover {
    font-size: 32px;
    color: rgba(247, 126, 203, 1.0);
    text-shadow: 0 0 10px rgba(32, 26, 41, 1.0);
}

.lang {
  display: flex;
  align-items: center;
  list-style: none;
  padding: 0;
  margin: 0;
  gap: 3px;
}

.lang li a {
  position: relative;
  margin: 0px;
  display: flex;
  font-family: 'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;
  font-size: 23px;
  font-weight: 540;
  text-decoration: none;
  color: rgba(74, 45, 107, 1.0);
  transition: 0.3s;
}

.lang a:hover {
    color: rgba(247, 126, 203, 1.0);
    text-shadow: 0 0 10px rgba(32, 26, 41, 1.0);
}

#welcome .title{
    text-align:center;
    font-family: sans-serif;
    font-size: 25px;
    color: rgba(74, 45, 107, 1.0);
    word-spacing:3px;
    transition: 0.2s;
}

#welcome .title:hover {
    text-shadow: 0 0 10px rgba(247, 126, 203, 1.0);
    text-decoration-line: underline;
    word-spacing:0px;
}

#welcome .title2{
    text-align: center;
    font-family: sans-serif;
    font-size: 20px;
    word-spacing:3px;
    color: rgba(74, 45, 107, 1.0);
    transition: 0.2s;
}

#welcome .title2:hover{
    text-shadow: 0 0 10px rgba(247, 126, 203, 1.0);
    text-decoration-line: overline;
    word-spacing: 0px;
}


/* ==================== SECTION TENTANG ==================== */
#tentang {
    margin-top: 60px;
    padding: 30px 10%;
    text-align: center;
}

#tentang .title h1 {
    font-family: sans-serif;
    font-size: 35px;
    color: rgba(74, 45, 107, 1.0);
    margin-bottom: 20px;
    letter-spacing: 1px;
    transition: 0.3s;
}

/* Efek menyala pink saat judul "Tentang" didekati kursor */
#tentang .title h1:hover {
    color: rgba(247, 126, 203, 1.0);
    text-shadow: 0 0 10px rgba(32, 26, 41, 1.0);
}

/* Desain kotak teks deskripsi komunitas */
#tentang .deskripsi {
    max-width: 700px;
    margin: 0 auto;
    padding: 25px;
    /* Membuat latar belakang kotak semi-transparan agar tulisan terbaca jelas di atas gambar */
    background-color: rgba(255, 255, 255, 0.75); 
    border: 3px solid rgba(74, 45, 107, 0.3);
    border-radius: 15px;
    box-shadow: 0 8px 20px rgba(74, 45, 107, 0.15);
    transition: 0.3s;
}

/* Efek hover pada kotak deskripsi agar terasa interaktif */
#tentang .deskripsi:hover {
    border-color: rgba(247, 126, 203, 1.0);
    box-shadow: 0 8px 25px rgba(247, 126, 203, 0.4);
    transform: translateY(-3px);
}

#tentang .deskripsi p {
    font-family: sans-serif;
    font-size: 18px;
    line-height: 1.6;
    color: rgba(74, 45, 107, 1.0); /* Menggunakan warna ungu tua khas tema Anda */
}

#tentang .deskripsi p strong {
    color: rgba(247, 126, 203, 1.0); /* Menyoroti nama komunitas dengan warna pink */
    text-shadow: 1px 1px 1px rgba(32, 26, 41, 0.2);
}

#tentang .bold {
    font-weight: 600;
    color: rgba(74, 45, 107, 1.0);
    text-shadow: 0 0 10px rgba(247, 126, 203, 1.0);
}


/* ==================== INI KODE FINAL KOTAK KOMUNITAS ==================== */
#komunitas {
    padding: 40px 5%;
    text-align: center;
}

.title-komunitas h2 {
    font-family: sans-serif;
    font-size: 25px;
    color: rgba(74, 45, 107, 1.0);
    margin-bottom: 30px;
}

.card-container {
    display: flex;
    justify-content: center;
    gap: 25px;
    flex-wrap: wrap;
}

.card {
    background-color: rgba(255, 255, 255, 0.85);
    border: 3px solid rgba(74, 45, 107, 0.2);
    border-radius: 15px;
    width: 300px;
    padding: 25px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    box-shadow: 0 8px 20px rgba(74, 45, 107, 0.1);
    transition: transform 0.3s, border-color 0.3s, box-shadow 0.3s;
}

.card:hover {
    transform: translateY(-8px);
    border-color: rgba(247, 126, 203, 1.0);
    box-shadow: 0 12px 25px rgba(247, 126, 203, 0.4);
}

/* --- Bingkai Bulat Foto Profil Komunitas --- */
.profile-frame {
    width: 80px;
    height: 80px;
    background-color: rgba(74, 45, 107, 0.1);
    border: 3px solid rgba(74, 45, 107, 1.0);
    border-radius: 50%;
    margin-bottom: 15px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
}

/* Jika ada file gambar profil */
.profile-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    z-index: 2;
}

/* Teks cadangan jika file gambar tidak ditemukan / kosong */
.avatar-fallback {
    font-size: 24px;
    font-weight: bold;
    color: rgba(74, 45, 107, 1.0);
    z-index: 1;
}

.card h3 {
    font-size: 20px;
    color: rgba(74, 45, 107, 1.0);
    margin-bottom: 10px;
}

.card p {
    font-size: 15px;
    color: rgba(74, 45, 107, 0.8);
    line-height: 1.5;
    margin-bottom: 25px;
    text-align: center;
}

/* --- Desain Tombol Join + Panah --- */
.btn-discord {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px; /* Jarak tulisan Join dengan tanda panah */
    text-decoration: none;
    background-color: rgba(74, 45, 107, 1.0);
    color: white;
    padding: 12px 20px;
    border-radius: 25px;
    font-weight: bold;
    font-size: 16px;
    transition: 0.3s;
    width: 100%;
}

.btn-discord .arrow {
    transition: transform 0.3s ease; /* Efek transisi pergerakan panah */
}

/* Efek Hover Tombol & Panah Bergerak ke Kanan */
.btn-discord:hover {
    background-color: rgba(247, 126, 203, 1.0);
    color: rgba(32, 26, 41, 1.0);
    box-shadow: 0 0 15px rgba(247, 126, 203, 0.7);
}

.btn-discord:hover .arrow {
    transform: translateX(5px); /* Menolak tanda panah geser ke kanan saat di-hover */
}


.profile-frame img {
    width: 80%;          /* Mengatur ukuran di dalam lingkaran */
    height: 80%;
    object-fit: contain; /* Kunci agar proporsi logo tetap pas dan tidak peyang */
    position: absolute;
    z-index: 2;
}


/* ==================== SECTION IDENTITAS FINAL ==================== */
#kontak {
    margin-top: 60px;
    padding: 40px 10%;
    text-align: center;
    margin-bottom: 80px;
}

#kontak .title h1 {
    font-family: sans-serif;
    font-size: 35px;
    color: rgba(74, 45, 107, 1.0);
    margin-bottom: 25px;
    letter-spacing: 1px;
    transition: 0.3s;
}

#kontak .title h1:hover {
    color: rgba(247, 126, 203, 1.0);
    text-shadow: 0 0 10px rgba(32, 26, 41, 1.0);
}

/* Kotak Utama Identitas */
.identitas-container {
    max-width: 500px;
    margin: 0 auto;
    padding: 30px;
    background-color: rgba(255, 255, 255, 0.85); /* Putih transparan agar background tembus manis */
    border: 3px solid rgba(74, 45, 107, 0.2);
    border-radius: 15px;
    box-shadow: 0 8px 20px rgba(74, 45, 107, 0.15);
    transition: 0.3s;
}

.identitas-container:hover {
    border-color: rgba(247, 126, 203, 1.0);
    box-shadow: 0 8px 25px rgba(247, 126, 203, 0.4);
}

.identitas-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 15px;
}

/* Baris List Identitas */
.identitas-list li {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding: 15px 20px;
    background-color: rgba(74, 45, 107, 0.05);
    border-radius: 8px;
    border: 1px solid transparent;
    transition: 0.3s;
    font-size: 18px;
    color: rgba(74, 45, 107, 1.0);
}

/* Efek Geser ke Kanan & Menyala Pink saat di-hover */
.identitas-list li:hover {
    border-color: rgba(247, 126, 203, 1.0);
    background-color: rgba(255, 255, 255, 1.0);
    box-shadow: 0 4px 12px rgba(247, 126, 203, 0.2);
    transform: translateX(8px); /* Efek UI game bergeser ke kanan */
}

.identitas-list .icon {
    font-size: 22px;
    margin-right: 15px;
}

.identitas-list .label {
    font-weight: 600;
    margin-right: 10px;
    min-width: 70px; /* Menjaga teks Nama, Kelas, Absen agar sejajar rapi */
    text-align: left;
}

.identitas-list .value {
    font-weight: bold;
    color: rgba(74, 45, 107, 1.0);
}

/* Membuat teks value otomatis berubah warna jadi ungu cerah saat baris di-hover */
.identitas-list li:hover .value {
    color: rgba(247, 126, 203, 1.0);
}